# Copy this to .env on the server (or set these as PM2 env vars) and fill in
# real values. Locally, leaving these unset falls back to sensible defaults.

# The master presentation files (index.html, global.js, css, assets) that
# every generated link is copied FROM. Never edit files inside a generated
# link's own folder expecting it to affect this template.
# PPT_TEMPLATE_DIR=/var/www/ppt-updated
# PPT_TEMPLATE_DIR=/ppt-updated

# # Where each generated link's own persistent copy lives.
# # A link for user "shivam" / company "digi" lands in:
# #   /var/www/ppt-links/shivam/digi/
# # PPT_LINKS_DIR=/var/www/ppt-links
# PPT_LINKS_DIR=/ppt-links

# Where per-link nginx location blocks get written. The main
# digilateral.com server block should `include` this directory once
# (see DEPLOY.md) so nothing else needs to change per link.
NGINX_SNIPPETS_DIR=/etc/nginx/snippets/ppt-links

# Where nginx access logs for each link go.
NGINX_LOG_DIR=/var/log/custom

# The domain the generated links should point to.
# PUBLIC_DOMAIN=https://digilateral.com
PUBLIC_DOMAIN=https://digilateral.com
VIEW_URL=https://digi-ppt.digilateral.com

MONGO_URI=mongodb://digilateraldev_db_user:digiroot@ac-zv1duad-shard-00-00.63pcuvp.mongodb.net:27017,ac-zv1duad-shard-00-01.63pcuvp.mongodb.net:27017,ac-zv1duad-shard-00-02.63pcuvp.mongodb.net:27017/automation?ssl=true&replicaSet=atlas-vlc937-shard-0&authSource=admin&appName=RXPL-PROD

ADMIN_USERNAME=digi@100
ADMIN_PASSWORD=Lateral@digi@100
SESSION_SECRET=some-long-random-string-here
