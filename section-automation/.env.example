# Server
PORT=2405
NODE_ENV=production

# Frontend origins, comma-separated
FRONTEND_URLS=https://digi-ppt.digilateral.com

# MongoDB
MONGO_URI=replace_with_mongodb_uri

# Authentication
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD=replace_with_admin_password
SESSION_SECRET=replace_with_long_random_session_secret

# Persistent presentation storage
PPT_TEMPLATE_DIR=/var/www/ppt-updated
PPT_LINKS_DIR=/var/www/ppt-links

# Generated file storage
FILE_UPLOAD_DIR=/var/www/section-automation/file-uploads
TUS_UPLOAD_DIR=/var/www/section-automation/tmp-uploads

# Public/generated URLs
PUBLIC_DOMAIN=https://digilateral.com
VIEW_URL=https://digi-ppt.digilateral.com

# Nginx generated presentation locations
NGINX_SNIPPETS_DIR=/etc/nginx/snippets/ppt-links
NGINX_LOG_DIR=/var/log/custom
ENABLE_NGINX=true

# Optional PDF generation command/path configuration
PDF_GENERATOR_PATH=/usr/bin/libreoffice
PDF_OUTPUT_DIR=/var/www/section-automation/pdf-output
