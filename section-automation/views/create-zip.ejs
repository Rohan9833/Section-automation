<script>
  function handleExpirationChange() {
    const expirationSelect = document.getElementById("expirationSelect");
    const customDateGroup = document.getElementById("customDateGroup");
    const customDateInput = document.getElementById("customDateInput");
    const previewGroup = document.getElementById("expirationPreviewGroup");
    const previewText = document.getElementById("expirationPreviewText");

    const value = expirationSelect.value;

    if (value === "custom") {
      // Show date picker
      customDateGroup.style.display = "block";

      // Show preview only when a date is selected
      if (customDateInput.value) {
        previewGroup.style.display = "block";
        previewText.textContent = formatDate(
          new Date(customDateInput.value)
        );
      }
    } else {
      // Hide custom date picker
      customDateGroup.style.display = "none";

      // Clear custom date
      customDateInput.value = "";

      if (value === "never") {
        previewGroup.style.display = "none";
        previewText.textContent = "—";
      }
    }
  }

  // Update preview when user selects a custom date
  document
    .getElementById("customDateInput")
    .addEventListener("change", function () {
      if (!this.value) return;

      const previewGroup =
        document.getElementById("expirationPreviewGroup");

      const previewText =
        document.getElementById("expirationPreviewText");

      previewGroup.style.display = "block";

      previewText.textContent = formatDate(
        new Date(this.value)
      );
    });
