  <script>
  function toggleActive() {
    const toggleTrack = document.getElementById("toggleTrack");
    const toggleThumb = document.getElementById("toggleThumb");
    const toggleLabel = document.getElementById("toggleLabel");
    const activeInput = document.getElementById("activeInput");

    const isActive = activeInput.value === "true";

    if (isActive) {
      // ACTIVE → INACTIVE
      activeInput.value = "false";

      toggleTrack.style.background = "#dc3545";
      toggleThumb.style.left = "3px";

      toggleLabel.textContent = "Inactive";
      toggleLabel.style.color = "#dc3545";
    } else {
      // INACTIVE → ACTIVE
      activeInput.value = "true";

      toggleTrack.style.background = "#f47a32";
      toggleThumb.style.left = "23px";

      toggleLabel.textContent = "Active";
      toggleLabel.style.color = "#f47a32";
    }
  }
