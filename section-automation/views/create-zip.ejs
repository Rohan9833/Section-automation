    ========================================================== -->

    <script>
      const fileInput =
        document.getElementById("fileInput");

      const dropZone =
        document.getElementById("dropZone");

      const selectedFiles =
        document.getElementById("selectedFiles");

      const fileList =
        document.getElementById("fileList");

      const zipForm =
        document.getElementById("zipForm");

      const submitBtn =
        document.getElementById("submitBtn");

      const submitBtnText =
        document.getElementById("submitBtnText");


      let selectedFileArray = [];


      /* =========================================================
         FILE INPUT
      ========================================================= */

      fileInput.addEventListener(
        "change",
        function () {

          addFiles(
            Array.from(this.files)
          );

        }
      );


      /* =========================================================
         DROP ZONE CLICK
      ========================================================= */

      dropZone.addEventListener(
        "click",
        function (event) {

          if (
            event.target.classList.contains(
              "browse-btn"
            ) ||
            event.target.closest(
              ".browse-btn"
            )
          ) {
            return;
          }

          fileInput.click();

        }
      );


      /* =========================================================
         DRAG OVER
      ========================================================= */

      dropZone.addEventListener(
        "dragover",
        function (event) {

          event.preventDefault();

          dropZone.classList.add(
            "dragover"
          );

        }
      );


      /* =========================================================
         DRAG LEAVE
      ========================================================= */

      dropZone.addEventListener(
        "dragleave",
        function () {

          dropZone.classList.remove(
            "dragover"
          );

        }
      );


      /* =========================================================
         DROP
      ========================================================= */

      dropZone.addEventListener(
        "drop",
        function (event) {

          event.preventDefault();

          dropZone.classList.remove(
            "dragover"
          );

          const files =
            Array.from(
              event.dataTransfer.files
            );

          addFiles(files);

        }
      );


      /* =========================================================
         ADD FILES
      ========================================================= */

      function addFiles(files) {

        files.forEach(function (file) {

          const alreadyExists =
            selectedFileArray.some(
              function (existingFile) {

                return (
                  existingFile.name === file.name &&
                  existingFile.size === file.size &&
                  existingFile.lastModified ===
                    file.lastModified
                );

              }
            );

          if (!alreadyExists) {

            selectedFileArray.push(file);

          }

        });

        updateFileList();

        updateInputFiles();

      }


      /* =========================================================
         UPDATE FILE LIST
      ========================================================= */

      function updateFileList() {

        fileList.innerHTML = "";

        if (
          selectedFileArray.length === 0
        ) {

          selectedFiles.classList.remove(
            "has-files"
          );

          return;

        }

        selectedFiles.classList.add(
          "has-files"
        );


        selectedFileArray.forEach(
          function (file, index) {

            const fileItem =
              document.createElement(
                "div"
              );

            fileItem.className =
              "file-item";


            fileItem.innerHTML = `

              <div class="file-info">

                <div class="file-icon">

                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >

                    <path
                      d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                    />

                    <polyline
                      points="14 2 14 8 20 8"
                    />

                  </svg>

                </div>


                <div>

                  <div
                    class="file-name"
                    title="${escapeHtml(file.name)}"
                  >
                    ${escapeHtml(file.name)}
                  </div>

                  <div class="file-size">
                    ${formatFileSize(file.size)}
                  </div>

                </div>

              </div>


              <button
                type="button"
                class="remove-file"
                onclick="removeFile(${index})"
                title="Remove file"
              >

                <svg
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >

                  <line
                    x1="18"
                    y1="6"
                    x2="6"
                    y2="18"
                  />

                  <line
                    x1="6"
                    y1="6"
                    x2="18"
                    y2="18"
                  />

                </svg>

              </button>

            `;


            fileList.appendChild(
              fileItem
            );

          }
        );

      }


      /* =========================================================
         REMOVE FILE
      ========================================================= */

      function removeFile(index) {

        selectedFileArray.splice(
          index,
          1
        );

        updateFileList();

        updateInputFiles();

      }


      /* =========================================================
         UPDATE REAL FILE INPUT
      ========================================================= */

      function updateInputFiles() {

        const dataTransfer =
          new DataTransfer();


        selectedFileArray.forEach(
          function (file) {

            dataTransfer.items.add(
              file
            );

          }
        );


        fileInput.files =
          dataTransfer.files;

      }


      /* =========================================================
         FILE SIZE
      ========================================================= */

      function formatFileSize(bytes) {

        if (bytes === 0) {
          return "0 Bytes";
        }


        const units = [
          "Bytes",
          "KB",
          "MB",
          "GB"
        ];


        const index =
          Math.floor(
            Math.log(bytes) /
              Math.log(1024)
          );


        const size =
          bytes /
          Math.pow(
            1024,
            index
          );


        return (
          size.toFixed(
            index === 0
              ? 0
              : 1
          ) +
          " " +
          units[index]
        );

      }


      /* =========================================================
         HTML ESCAPE
      ========================================================= */

      function escapeHtml(text) {

        const div =
          document.createElement(
            "div"
          );

        div.textContent = text;

        return div.innerHTML;

      }


      /* =========================================================
         FORM SUBMIT
         IMPORTANT:
         NO NORMAL FORM SUBMISSION
      ========================================================= */

      zipForm.addEventListener(
        "submit",
        async function (event) {

          event.preventDefault();

          event.stopPropagation();


          console.log(
            "ZIP FORM SUBMITTED"
          );


          /* =====================================================
             VALIDATE FILES
          ===================================================== */

          if (
            selectedFileArray.length === 0
          ) {

            alert(
              "Please select at least one file."
            );

            return;

          }


          /* =====================================================
             DISABLE BUTTON
          ===================================================== */

          submitBtn.disabled = true;

          submitBtnText.textContent =
            "Creating ZIP...";


          try {

            /* ===================================================
               CREATE FORMDATA
            =================================================== */

            const formData =
              new FormData();


            /* ===================================================
               TEXT FIELDS
            =================================================== */

            formData.append(
              "companyName",
              document.getElementById(
                "companyName"
              ).value
            );

            formData.append(
              "divisionName",
              document.getElementById(
                "division"
              ).value
            );

            formData.append(
              "individualName",
              document.getElementById(
                "individual"
              ).value
            );

            formData.append(
              "projectName",
              document.getElementById(
                "projectName"
              ).value
            );

            formData.append(
              "zipFileName",
              document.getElementById(
                "fileName"
              ).value
            );

            /* ===================================================
               LINK STATUS & EXPIRATION
            =================================================== */

            // Active/Inactive status as boolean
            const activeInput = document.getElementById("activeInput");
            formData.append(
              "active",
              activeInput && activeInput.value === "true"
            );

            // Expiration settings
            const expirationSelect = document.getElementById("expirationSelect");
            const customDateInput = document.getElementById("customDateInput");

            // Send the selected expiration option
            formData.append(
              "expiration",
              expirationSelect.value
            );

            // Send custom expiration date if "custom" is selected
            if (expirationSelect.value === "custom") {
              formData.append(
                "customExpiration",
                customDateInput.value || ""
              );
            } else {
              // Send empty string for non-custom options
              formData.append(
                "customExpiration",
                ""
              );
            }

            /* ===================================================
               MULTIPLE FILES
            =================================================== */

            selectedFileArray.forEach(
              function (file) {

                formData.append(
                  "files",
                  file
                );

              }
            );


            /* ===================================================
               DEBUG
            =================================================== */

            console.log(
              "Sending ZIP request..."
            );

            for (
              const [key, value]
              of formData.entries()
            ) {

              console.log(
                key,
                value
              );

            }


            /* ===================================================
               API CALL
            =================================================== */

            const response =
              await fetch(
                "/zip/upload",
                {
                  method: "POST",
                  body: formData
                }
              );


            /* ===================================================
               RESPONSE
            =================================================== */

            let data;

            try {

              data =
                await response.json();

            } catch (jsonError) {

              throw new Error(
                "Server returned an invalid response."
              );

            }


            console.log(
              "ZIP API RESPONSE:",
              data
            );


            /* ===================================================
               ERROR
            =================================================== */

            if (!response.ok) {

              throw new Error(
                data.message ||
                "Failed to create ZIP"
              );

            }


            /* ===================================================
               SUCCESS
            =================================================== */

            showZipSuccessPopup(
              data
            );
            resetZipForm();

          } catch (error) {

            console.error(
              "ZIP ERROR:",
              error
            );


            alert(
              error.message ||
              "Something went wrong while creating ZIP."
            );


          } finally {

            submitBtn.disabled =
              false;

            submitBtnText.textContent =
              "Create ZIP";

          }

        }
      );


      /* =========================================================
         SUCCESS POPUP
      ========================================================= */

      function showZipSuccessPopup(
        data
      ) {

        const popup =
          document.getElementById(
            "zipSuccessPopup"
          );


        const fileName =
          document.getElementById(
            "successFileName"
          );


        const link =
          document.getElementById(
            "successZipLink"
          );


        const downloadBtn =
          document.getElementById(
            "downloadZipBtn"
          );


        /* =====================================================
           GET LINK
        ===================================================== */

        const zipLink =
          data.link ||
          data.url ||
          data.downloadUrl ||
          data.zipUrl ||
          "";


        /* =====================================================
           GET FILE NAME
        ===================================================== */

        const zipName =
          data.fileName ||
          data.zipFileName ||
          "ZIP file";


        fileName.textContent =
          zipName;


        if (zipLink) {

          link.href =
            zipLink;

          link.textContent =
            zipLink;


          downloadBtn.href =
            zipLink;

          downloadBtn.style.display =
            "flex";

        } else {

          link.removeAttribute(
            "href"
          );

          link.textContent =
            "Download link was not returned by server.";


          downloadBtn.style.display =
            "none";

        }


        popup.classList.add(
          "open"
        );

      }


      /* =========================================================
         CLOSE SUCCESS POPUP
      ========================================================= */

      function closeZipSuccessPopup() {

        const popup =
          document.getElementById(
            "zipSuccessPopup"
          );

        popup.classList.remove(
          "open"
        );

      }


      /* =========================================================
         CLOSE POPUP WHEN CLICKING OUTSIDE
      ========================================================= */

      document
        .getElementById(
          "zipSuccessPopup"
        )
        .addEventListener(
          "click",
          function (event) {

            if (
              event.target ===
              this
            ) {

              closeZipSuccessPopup();

            }

          }
        );
 
  function copySuccessZipLink() {
    const linkElement =
      document.getElementById("successZipLink");

    const copiedText =
      document.getElementById("copiedText");

    const link = linkElement.href;

    if (
      !link ||
      link === "#" ||
      link === window.location.href + "#"
    ) {
      return;
    }

    navigator.clipboard
      .writeText(link)
      .then(() => {
        copiedText.style.display = "block";

        setTimeout(() => {
          copiedText.style.display = "none";
        }, 2000);
      })
      .catch(() => {
        const textarea =
          document.createElement("textarea");

        textarea.value = link;

        document.body.appendChild(textarea);

        textarea.select();

        document.execCommand("copy");

        textarea.remove();

        copiedText.style.display = "block";

        setTimeout(() => {
          copiedText.style.display = "none";
        }, 2000);
      });
  }



  function resetZipForm() {
    // Text fields clear
    document.getElementById("companyName").value = "";
    document.getElementById("division").value = "";
    document.getElementById("individual").value = "";
    document.getElementById("projectName").value = "";
    document.getElementById("fileName").value = "";

    // File input clear
    const fileInput = document.getElementById("fileInput");

    if (fileInput) {
      fileInput.value = "";
    }

    // Selected files array clear
    if (typeof selectedFileArray !== "undefined") {
      selectedFileArray.length = 0;
    }

    // File list UI clear
    const fileList = document.getElementById("fileList");

    if (fileList) {
      fileList.innerHTML = "";
    }

    // File count / selected files text reset
    const fileCount = document.getElementById("fileCount");

    if (fileCount) {
      fileCount.textContent = "No files selected";
    }

    // Active status reset
    const activeInput =
      document.getElementById("activeInput");

    if (activeInput) {
      activeInput.value = "true";
    }

    const toggleTrack =
      document.getElementById("toggleTrack");

    const toggleThumb =
      document.getElementById("toggleThumb");

    const toggleLabel =
      document.getElementById("toggleLabel");

    if (toggleTrack) {
      toggleTrack.style.background = "#f47a32";
    }

    if (toggleThumb) {
      toggleThumb.style.left = "23px";
    }

    if (toggleLabel) {
      toggleLabel.textContent = "Active";
      toggleLabel.style.color = "#f47a32";
    }
  }

    </script>

