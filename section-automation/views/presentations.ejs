<script>
  function switchPresentationType(type) {
    const linksTab = document.getElementById("linksTab");
    const zipsTab = document.getElementById("zipsTab");

    const linksContent = document.getElementById("linksContent");
    const zipsContent = document.getElementById("zipsContent");

    if (type === "links") {
      // ==========================
      // LINKS ACTIVE
      // ==========================

      linksContent.style.display = "block";
      zipsContent.style.display = "none";

      linksTab.style.background = "#f47a32";
      linksTab.style.color = "#ffffff";
      linksTab.style.fontWeight = "600";

      zipsTab.style.background = "transparent";
      zipsTab.style.color = "#777b82";
      zipsTab.style.fontWeight = "500";

    } else {
      // ==========================
      // ZIPS ACTIVE
      // ==========================

      linksContent.style.display = "none";
      zipsContent.style.display = "block";

      zipsTab.style.background = "#f47a32";
      zipsTab.style.color = "#ffffff";
      zipsTab.style.fontWeight = "600";

      linksTab.style.background = "transparent";
      linksTab.style.color = "#777b82";
      linksTab.style.fontWeight = "500";
    }
  }
</script>

<!-- Settings Modal -->
<div id="settingsModal" class="modal-overlay">
  <div class="modal-box">
    <button class="modal-close" onclick="closeSettings()">×</button>
    <h2 class="modal-title">Presentation Settings</h2>
    <p class="modal-sub">Configure link status and expiration.</p>
    <form id="settingsForm" onsubmit="saveSettings(event)">
      <div class="modal-group">
        <label>Link Status</label>
        <div class="toggle-wrap">
          <div class="toggle-track" id="toggleTrack" onclick="toggleActive()">
            <div class="toggle-thumb"></div>
          </div>
          <span class="toggle-label" id="toggleLabel">Active</span>
        </div>
        <div class="hint">When inactive, the link will show as expired/inactive to users.</div>
      </div>

      <div class="modal-group">
        <label>Expiration</label>
        <select id="expirationSelect" class="modal-select" onchange="handleExpirationChange()">
          <option value="never">No expiration</option>
          <option value="1d">1 day</option>
          <option value="7d">7 days</option>
          <option value="30d">30 days</option>
          <option value="90d">90 days</option>
          <option value="custom">Custom date</option>
        </select>
        <div class="hint">Set when this presentation link should expire.</div>
      </div>

      <div class="modal-group" id="customDateGroup" style="display:none;">
        <label>Custom expiration date</label>
        <input type="datetime-local" id="customDateInput" class="modal-input" />
        <div class="hint">Select a specific date and time for expiration.</div>
      </div>

      <div class="modal-group" id="expirationPreviewGroup" style="display:none;">
        <div class="expiration-preview-box">
          <strong>Will expire:</strong>
          <span id="expirationPreviewText">—</span>
        </div>
      </div>

      <input type="hidden" id="presentationId" value="" />
      <div class="modal-actions">
        <button type="button" class="modal-btn modal-btn-secondary" onclick="closeSettings()">Cancel</button>
        <button type="submit" class="modal-btn modal-btn-primary">Save Settings</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function() {
    // Search
    var searchInput = document.getElementById('searchInput');
    var rows = document.querySelectorAll('.presentation-row');
    if (searchInput && rows.length) {
      searchInput.addEventListener('input', function() {
        var query = this.value.toLowerCase().trim();
        rows.forEach(function(row) {
          var project = (row.getAttribute('data-project') || '').toLowerCase();
          var company = (row.getAttribute('data-company') || '').toLowerCase();
          var division = (row.getAttribute('data-division') || '').toLowerCase();
          var user = (row.getAttribute('data-user') || '').toLowerCase();
          var match = project.includes(query) || company.includes(query) || division.includes(query) || user.includes(query);
          row.style.display = match ? '' : 'none';
        });
      });
    }

    window.copyLink = function(url) {
      var fullUrl = window.location.origin + url;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(fullUrl).then(function() {
          showToast('Link copied to clipboard!');
        }).catch(function() {
          fallbackCopy(fullUrl);
        });
      } else {
        fallbackCopy(fullUrl);
      }
    };
    function fallbackCopy(text) {
      var textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      try {
        document.execCommand('copy');
        showToast('Link copied to clipboard!');
      } catch (err) {
        prompt('Copy this link:', text);
      }
      document.body.removeChild(textarea);
    }

    function showToast(message) {
      var existing = document.querySelector('.toast-notification');
      if (existing) existing.remove();
      var toast = document.createElement('div');
      toast.className = 'toast-notification';
      toast.textContent = message;
      document.body.appendChild(toast);
      setTimeout(function() {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(-50%) translateY(20px)';
        toast.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
        setTimeout(function() { toast.remove(); }, 400);
      }, 3000);
    }

    // --- Settings Modal ---
    var currentPresentationId = null;
    var currentIsActive = true;

    function utcToLocal(utcDateString) {
      if (!utcDateString) return '';
      var date = new Date(utcDateString);
      var localDate = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
      return localDate.toISOString().slice(0, 16);
    }

    function formatDate(date) {
      if (!date) return '—';
      return date.toLocaleString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    }

window.openSettings = function (id) {
  currentPresentationId = id;

  var row = document.querySelector(
    '.presentation-row[data-id="' + id + '"]'
  );

  if (!row) return;

  // ==========================================
  // ACTIVE / INACTIVE
  // ==========================================

  var isActive =
    row.getAttribute("data-is-active") === "true";

  currentIsActive = isActive;

  var track = document.getElementById("toggleTrack");
  var thumb = document.getElementById("toggleThumb");
  var label = document.getElementById("toggleLabel");
  var activeInput = document.getElementById("activeInput");

  if (isActive) {
    track.classList.add("active");

    // Active = Orange
    track.style.background = "#f47a32";

    if (thumb) {
      thumb.style.left = "23px";
    }

    label.textContent = "Active";
    label.style.color = "#f47a32";

    if (activeInput) {
      activeInput.value = "true";
    }
  } else {
    track.classList.remove("active");

    // Inactive = Red
    track.style.background = "#dc3545";

    if (thumb) {
      thumb.style.left = "3px";
    }

    label.textContent = "Inactive";
    label.style.color = "#dc3545";

    if (activeInput) {
      activeInput.value = "false";
    }
  }

  // ==========================================
  // EXPIRATION DATA FROM MONGODB
  // ==========================================

  var expirationType =
    row.getAttribute("data-expiration-type") || "never";

  var expiresAt =
    row.getAttribute("data-expires-at") || null;

  var expirationSelect =
    document.getElementById("expirationSelect");

  var customDateInput =
    document.getElementById("customDateInput");

  var customGroup =
    document.getElementById("customDateGroup");

  var previewGroup =
    document.getElementById("expirationPreviewGroup");

  var previewText =
    document.getElementById("expirationPreviewText");

  // Set expiration dropdown
  expirationSelect.value = expirationType;

  // ==========================================
  // EXISTING EXPIRATION DATE
  // ==========================================

  if (expiresAt) {
    /*
      MongoDB UTC date
          ↓
      Local datetime input
    */

    customDateInput.value = utcToLocal(expiresAt);

    // Date field visible so user can edit it
    customGroup.style.display = "block";

    // Show current expiration
    previewGroup.style.display = "block";

    previewText.textContent =
      formatDate(new Date(expiresAt));
  }

  // ==========================================
  // NO EXPIRATION
  // ==========================================

  else {
    customDateInput.value = "";

    customGroup.style.display = "none";

    previewGroup.style.display = "none";

    previewText.textContent = "—";
  }

  // ==========================================
  // OPEN MODAL
  // ==========================================

  document
    .getElementById("settingsModal")
    .classList.add("open");
};


    window.closeSettings = function() {
      document.getElementById('settingsModal').classList.remove('open');
    };

    window.toggleActive = function() {
      var track = document.getElementById('toggleTrack');
      var label = document.getElementById('toggleLabel');
      track.classList.toggle('active');
      label.textContent = track.classList.contains('active') ? 'Active' : 'Inactive';
      currentIsActive = track.classList.contains('active');
    };

    window.handleExpirationChange = function() {
      var select = document.getElementById('expirationSelect');
      var customGroup = document.getElementById('customDateGroup');
      var previewGroup = document.getElementById('expirationPreviewGroup');
      var previewText = document.getElementById('expirationPreviewText');

      if (select.value === 'custom') {
        customGroup.style.display = 'block';
        if (!document.getElementById('customDateInput').value) {
          var now = new Date();
          var localDate = new Date(now.getTime() - now.getTimezoneOffset() * 60000);
          document.getElementById('customDateInput').value = localDate.toISOString().slice(0, 16);
        }
        var customVal = document.getElementById('customDateInput').value;
        if (customVal) {
          previewGroup.style.display = 'block';
          previewText.textContent = formatDate(new Date(customVal));
        }
      } else if (select.value !== 'never') {
        customGroup.style.display = 'none';
        var days = parseInt(select.value);
        var date = new Date();
        date.setDate(date.getDate() + days);
        previewGroup.style.display = 'block';
        previewText.textContent = formatDate(date);
      } else {
        customGroup.style.display = 'none';
        previewGroup.style.display = 'none';
      }
    };

    document.addEventListener('change', function(e) {
      if (e.target.id === 'customDateInput') {
        var previewGroup = document.getElementById('expirationPreviewGroup');
        var previewText = document.getElementById('expirationPreviewText');
        if (e.target.value) {
          previewGroup.style.display = 'block';
          previewText.textContent = formatDate(new Date(e.target.value));
        }
      }
    });

    window.saveSettings = function (e) {
  e.preventDefault();

  var id = currentPresentationId;

  var isActive =
    document
      .getElementById("toggleTrack")
      .classList.contains("active");

  var expirationSelect =
    document.getElementById("expirationSelect");

  var expirationType =
    expirationSelect.value;

  var customDateInput =
    document.getElementById("customDateInput");

  var customDate =
    customDateInput.value;

  var expiresAt = null;

  // ==========================================
  // CUSTOM DATE
  // ==========================================

  if (expirationType === "custom") {
    if (!customDate) {
      showToast("Please select an expiration date");
      return;
    }

    var date = new Date(customDate);

    if (isNaN(date.getTime())) {
      showToast("Invalid expiration date");
      return;
    }

    if (date <= new Date()) {
      showToast("Expiration must be in the future");
      return;
    }

    expiresAt = date.toISOString();
  }

  // ==========================================
  // PRESET EXPIRATION
  // ==========================================

  else if (expirationType !== "never") {
    var days = parseInt(expirationType, 10);

    if (isNaN(days)) {
      showToast("Invalid expiration period");
      return;
    }

    var futureDate = new Date();

    futureDate.setDate(
      futureDate.getDate() + days
    );

    expiresAt =
      futureDate.toISOString();
  }

  // ==========================================
  // NEVER
  // ==========================================

  else {
    expiresAt = null;
  }

  // ==========================================
  // PAYLOAD
  // ==========================================

  var payload = {
    isActive: isActive,
    expirationType: expirationType,
    expiresAt: expiresAt
  };

  // ==========================================
  // SAVE TO BACKEND
  // ==========================================

  fetch(
    "/presentations/" + id + "/settings",
    {
      method: "PATCH",

      headers: {
        "Content-Type": "application/json"
      },

      body: JSON.stringify(payload)
    }
  )
    .then(function (res) {
      if (!res.ok) {
        throw new Error(
          "Failed to save settings"
        );
      }

      return res.json();
    })

    .then(function (data) {
      closeSettings();

      showToast(
        "Settings saved successfully!"
      );

      // Update row immediately
      updateRowUI(
        id,
        isActive,
        expirationType,
        expiresAt
      );
    })

    .catch(function (err) {
      console.error(
        "Error saving settings:",
        err
      );

      showToast(
        "Error saving settings: " +
        err.message
      );
    });
};


function updateRowUI(id, isActive, expirationType, expiresAt) {
  var row = document.querySelector(
    '.presentation-row[data-id="' + id + '"]'
  );

  if (!row) return;

  // ==========================================
  // UPDATE DATA ATTRIBUTES
  // ==========================================

  row.setAttribute("data-is-active", isActive);
  row.setAttribute("data-expiration-type", expirationType);

  if (expiresAt) {
    row.setAttribute("data-expires-at", expiresAt);
  } else {
    row.removeAttribute("data-expires-at");
  }

  // ==========================================
  // STATUS CELL
  // ==========================================

  var statusCell = row.querySelector("td:nth-child(5)");

  if (!statusCell) return;

  var isExpired =
    expiresAt
      ? new Date(expiresAt) < new Date()
      : false;

  var badge =
    statusCell.querySelector(".status-badge");

  if (!badge) {
    badge = document.createElement("span");
    badge.className = "status-badge";

    statusCell.innerHTML = "";
    statusCell.appendChild(badge);
  }

  // ==========================================
  // ACTIVE
  // ==========================================

  if (isActive && !isExpired) {
    badge.className =
      "status-badge status-active";

    badge.textContent = "Active";
  }

  // ==========================================
  // INACTIVE
  // ==========================================

  else if (!isActive) {
    badge.className =
      "status-badge status-inactive";

    badge.textContent = "Inactive";
  }

  // ==========================================
  // EXPIRED
  // ==========================================

  else if (isExpired) {
    badge.className =
      "status-badge status-expired";

    badge.innerHTML =
      '<span class="status-dot"></span>Expired';
  }
}

    document.getElementById('settingsModal').addEventListener('click', function(e) {
      if (e.target === this) closeSettings();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeSettings();
    });
  })();
</script>
<script>

  let zipDashboardLoaded = false;


  /* =====================================================
     LINK / ZIP SWITCH
  ===================================================== */

  window.switchPresentationType = function(type) {

    const linksContent =
      document.getElementById(
        "linksContent"
      );

    const zipsContent =
      document.getElementById(
        "zipsContent"
      );

    const linksTab =
      document.getElementById(
        "linksTab"
      );

    const zipsTab =
      document.getElementById(
        "zipsTab"
      );


    if (!linksContent || !zipsContent) {
      return;
    }


    /* ===================================================
       LINKS
    =================================================== */

    if (type === "links") {

      linksContent.style.display =
        "block";

      zipsContent.style.display =
        "none";


      // Active Links

      linksTab.style.background =
        "#f47a32";

      linksTab.style.color =
        "#ffffff";

      linksTab.style.fontWeight =
        "600";


      // Inactive ZIPs

      zipsTab.style.background =
        "transparent";

      zipsTab.style.color =
        "#777b82";

      zipsTab.style.fontWeight =
        "500";

      return;
    }


    /* ===================================================
       ZIPS
    =================================================== */

    if (type === "zips") {

      linksContent.style.display =
        "none";

      zipsContent.style.display =
        "block";


      // Active ZIPs

      zipsTab.style.background =
        "#f47a32";

      zipsTab.style.color =
        "#ffffff";

      zipsTab.style.fontWeight =
        "600";


      // Inactive Links

      linksTab.style.background =
        "transparent";

      linksTab.style.color =
        "#777b82";

      linksTab.style.fontWeight =
        "500";


      /* ================================================
         LOAD ZIP DATA
      ================================================ */

      if (!zipDashboardLoaded) {

        loadZipDashboard();

      }

    }

  };


  /* =====================================================
     LOAD ZIP DASHBOARD
  ===================================================== */

  async function loadZipDashboard() {

    const tbody =
      document.getElementById(
        "zipTableBody"
      );


    if (!tbody) {
      return;
    }


    try {

      tbody.innerHTML = `
        <tr>
          <td
            colspan="6"
            style="
              text-align:center;
              padding:40px 24px;
              color:#9a9da3;
              font-size:13px;
            "
          >
            Loading ZIP files...
          </td>
        </tr>
      `;


      const response =
        await fetch(
          "/zip/dashboard",
          {
            method: "GET",
            headers: {
              "Accept": "application/json"
            }
          }
        );


      const data =
        await response.json();


      if (!response.ok) {

        throw new Error(
          data.message ||
          "Failed to load ZIP files."
        );

      }


      if (
        !data.success ||
        !Array.isArray(data.fileShares)
      ) {

        throw new Error(
          "Invalid ZIP dashboard response."
        );

      }


      renderZipRows(
        data.fileShares
      );


      zipDashboardLoaded =
        true;


    } catch (error) {

      console.error(
        "ZIP DASHBOARD ERROR:",
        error
      );


      tbody.innerHTML = `
        <tr>
          <td
            colspan="6"
            style="
              text-align:center;
              padding:40px 24px;
              color:#dc3545;
              font-size:13px;
            "
          >
            Failed to load ZIP files.
          </td>
        </tr>
      `;

    }

  }


  /* =====================================================
     RENDER ZIP ROWS
  ===================================================== */

  function renderZipRows(
    fileShares
  ) {

    const tbody =
      document.getElementById(
        "zipTableBody"
      );


    if (!tbody) {
      return;
    }


    /* ===================================================
       NO DATA
    =================================================== */

    if (fileShares.length === 0) {

      tbody.innerHTML = `
        <tr>
          <td
            colspan="6"
            style="
              text-align:center;
              padding:40px 24px;
              color:#9a9da3;
              font-size:13px;
            "
          >
            No ZIP files found.
          </td>
        </tr>
      `;

      return;
    }


    /* ===================================================
       BASE URL
    =================================================== */

    const baseUrl =
      "<%= process.env.BASE_URL %>";


    tbody.innerHTML =
      fileShares
        .map(function(zip) {

          const company =
            encodeURIComponent(
              zip.companyName
            );

          const division =
            encodeURIComponent(
              zip.divisionName
            );

          const individual =
            encodeURIComponent(
              zip.individualName
            );

          const project =
            encodeURIComponent(
              zip.projectName
            );


          const zipUrl =
            baseUrl +
            "/zip/" +
            company +
            "/" +
            division +
            "/" +
            individual +
            "/" +
            project;


          /* =============================================
             FILE SIZE
          ============================================= */

         const lastDownloaded =
            zip.lastDownloadedAt
              ? new Date(zip.lastDownloadedAt).toLocaleString()
              : "Never downloaded";

          /* =============================================
             CREATED
          ============================================= */

          const created =
            zip.createdAt
              ? new Date(
                  zip.createdAt
                ).toLocaleString()
              : "—";


          /* =============================================
             EXPIRED
          ============================================= */

          const isExpired =
            zip.expiresAt &&
            new Date(
              zip.expiresAt
            ) < new Date();


          let statusHtml;


          if (!zip.active) {

            statusHtml = `
              <span
                class="status-badge status-inactive"
              >
                Inactive
              </span>
            `;

          } else if (isExpired) {

            statusHtml = `
              <span
                class="status-badge status-expired"
              >
                <span class="status-dot"></span>
                Expired
              </span>
            `;

          } else {

            statusHtml = `
              <span
                class="status-badge status-active"
              >
                Active
              </span>
            `;

          }


          /* =============================================
             RETURN ROW
          ============================================= */

          return `

            <tr
              class="zip-row"
              style="padding:5px"
              data-id="${zip._id}"
            >

              <!-- LINK -->

              <td style="padding: 14px 20px;">

                <a
                  href="${zipUrl}"
                  target="_blank"
                  class="presentation-link"
                  title="${zipUrl}"
                >

                  <span class="link-icon">

                    <svg viewBox="0 0 24 24">

                      <circle
                        cx="12"
                        cy="12"
                        r="10"
                      />

                      <line
                        x1="2"
                        y1="12"
                        x2="22"
                        y2="12"
                      />

                      <path
                        d="M12 2a15.3 15.3 0 0 1 4 10
                        15.3 15.3 0 0 1-4 10
                        15.3 15.3 0 0 1-4-10
                        15.3 15.3 0 0 1 4-10z"
                      />

                    </svg>

                  </span>


                  <span class="link-text">

                    ${zipUrl}

                  </span>

                </a>


                <div class="link-meta">

                  ${zip.companyName}
                  ·
                  ${zip.divisionName}
                  ·
                  ${zip.individualName}
                  ·
                  ${zip.projectName}

                </div>

              </td>


              <!-- CREATED -->

              <td
                style="
                  color:#55585d;
                  font-size:13px;
                "
              >

                ${created}

              </td>


              <!-- LAST DOWNLOADED -->

              <td style="font-size:13px;">
                ${lastDownloaded}
              </td>


              <!-- DOWNLOAD COUNT -->

              <td style="padding: 14px 20px;">

                <span class="view-count">

                  ${zip.downloadCount || 0}

                </span>

              </td>


              <!-- STATUS -->

              <td style="padding: 14px 20px;">

                ${statusHtml}

              </td>


              <!-- ACTIONS -->

              <td style="text-align:right; padding: 14px 20px;">

                <div
                  style="
                    display:flex;
                    align-items:center;
                    justify-content:flex-end;
                    gap:6px;
                  "
                >

                  <!-- DOWNLOAD -->

                  <a
                    href="${zipUrl}"
                    target="_blank"
                    class="action-btn action-btn-open"
                    title="Download"
                  >
                    <svg viewBox="0 0 24 24">
                      <path d="M12 3v12" />
                      <path d="M7 10l5 5 5-5" />
                      <path d="M5 21h14" />
                    </svg>
                  </a>

                  <!-- COPY -->

                  <button
                    onclick="copyLink('/zip/${company}/${division}/${individual}/${project}')"
                    class="action-btn action-btn-copy"
                    title="Copy"
                  >
                    <svg viewBox="0 0 24 24">
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                      <path d="M5 15H4a2 2 0 0 1-2-2V4 a2 2 0 0 1 2-2h9 a2 2 0 0 1 2 2v1" />
                    </svg>
                  </button>

                </div>

              </td>

            </tr>

          `;

        })
        .join("");

  }


  /* =====================================================
     FILE SIZE FORMATTER
  ===================================================== */

  function formatFileSize(
    bytes
  ) {

    if (
      bytes === null ||
      bytes === undefined ||
      bytes === 0
    ) {

      return "0 B";

    }


    const units = [
      "B",
      "KB",
      "MB",
      "GB",
      "TB"
    ];


    const index =
      Math.floor(
        Math.log(bytes) /
        Math.log(1024)
      );


    return (
      parseFloat(
        (
          bytes /
          Math.pow(
            1024,
            index
          )
        ).toFixed(2)
      ) +
      " " +
      units[index]
    );

  }


  /* =====================================================
     DEFAULT TAB
  ===================================================== */

  document.addEventListener(
    "DOMContentLoaded",
    function() {

      switchPresentationType(
        "links"
      );

    }
  );

</script>
</body>
</html>